NODE_ENV=development
PORT=3000

# Runtime application connection. Use the provider's pooled URL in production.
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/customer360

# Migration connection. Use the provider's direct URL in production.
DIRECT_URL=postgresql://postgres:replace_me@localhost:5432/customer360

JWT_SECRET=replace_with_a_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m

CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=100kb

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10